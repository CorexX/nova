# Copy this file to <your-secrets-dir>/planner.env and fill it there.
# No secrets are stored here by default; auth uses `az login` / Azure CLI cached login.
# Do NOT commit the real config file if you add local notes to it.

# Tenant that owns the Planner plans you want to inspect.
# Find it in the shared Planner link's `tid=` parameter.
PLANNER_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional default plan id so `scripts/planner.sh tasks` or `buckets` can run without a selector.
# Find it in the shared Planner URL's `planId=` / `/plans/<id>` segment.
PLANNER_DEFAULT_PLAN_ID=your_plan_id_here
