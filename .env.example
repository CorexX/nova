# NOVA Configuration
# Copy this file to .env and fill in your values

# Azure AI Foundry (Anthropic via OpenAI endpoint)
NOVA_AZURE_ENDPOINT=https://vitafoundry.openai.azure.com/anthropic
NOVA_AZURE_API_KEY=your-api-key-here
NOVA_MODEL=claude-opus-4-6

# Alternative: OpenAI directly
# NOVA_OPENAI_API_KEY=sk-...

# Alternative: Anthropic
# NOVA_ANTHROPIC_API_KEY=sk-ant-...

# n8n API (for nova_n8n_* tools)
# Accepts either host URL or full workflow URL; host is recommended.
N8N_BASE_URL=https://n8n.home
N8N_API_KEY=your-n8n-api-key-here

# n8n assistant workflow target (used by assistant_v1_telegram_qa.json)
# Either set full URL directly...
NOVA_ASSISTANT_QUERY_URL=https://your-nova-host/assistant/query/replace-with-secret
# ...or let the workflow build it from these two:
# NOVA_SERVER_BASE_URL=https://your-nova-host
# ASSISTANT_WEBHOOK_SECRET=replace-with-secret

# Optional: disable TLS certificate verification for self-signed/internal certs.
# Security warning: use only in trusted internal networks.
N8N_INSECURE_TLS=false
